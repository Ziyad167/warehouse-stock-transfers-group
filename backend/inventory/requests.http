@baseUrl = http://localhost:3001
@managerToken = {{loginManager.response.body.$.token}}
@staffToken = {{loginStaff.response.body.$.token}}

### ---------- LOGIN AND ROLES ----------
### Run A01 and A02 first: the other tests use their tokens.

### A01 Log in as manager (expect 200 with a token)
# @name loginManager
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "cloud123",
  "password": "Cloud123456"}

### A02 Log in as staff (expect 200 with a token)
# @name loginStaff
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "staff12",
  "password": "Staff12344"
}

### A03 Wrong password (expect 401 INVALID_LOGIN)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "cloud123",
  "password": "wrong-password"
}

### A04 Who am I (expect 200, staff)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{staffToken}}

### A05 No token (expect 401 UNAUTHORIZED)
GET {{baseUrl}}/api/warehouses

### A06 Staff views stock (expect 200)
GET {{baseUrl}}/api/warehouses/WH-101/inventory
Authorization: Bearer {{staffToken}}

### A07 Staff creates a warehouse (expect 403 FORBIDDEN)
POST {{baseUrl}}/api/warehouses
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "name": "Giza Warehouse",
  "location": "Giza"
}

### A08 Staff updates stock (expect 200, staff is allowed)
PATCH {{baseUrl}}/api/inventory/INV-101
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "change": 5
}

### A09 Staff logs out (expect 200)
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{staffToken}}

### A10 Staff token after logout (expect 401). Run A02 again to log in again.
GET {{baseUrl}}/api/warehouses
Authorization: Bearer {{staffToken}}

### A11 Correct username and password but the wrong role (expect 403 WRONG_ROLE)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "staff12",
  "password": "Staff12344",
  "role": "manager"
}

### A12 Role that does not exist (expect 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "staff12",
  "password": "Staff12344",
  "role": "boss"
}

### ---------- WAREHOUSES ----------

### T00 Health check
GET {{baseUrl}}/api/health

### T01 View all warehouses
GET {{baseUrl}}/api/warehouses
Authorization: Bearer {{managerToken}}

### T02 Create a valid warehouse (expect 201 the first time, 409 DUPLICATE_WAREHOUSE if it already exists)
POST {{baseUrl}}/api/warehouses
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Giza Warehouse",
  "location": "Giza"
}

### T07 Same name as an existing warehouse, different capitals (expect 409 DUPLICATE_WAREHOUSE)
POST {{baseUrl}}/api/warehouses
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "cairo main warehouse",
  "location": "Cairo"
}

### T03 Missing name (expect 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/warehouses
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "location": "Giza"
}

### T04 Location too short (expect 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/warehouses
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Giza Warehouse",
  "location": "G"
}

### T05 Wrong content type (expect 415 UNSUPPORTED_MEDIA_TYPE)
POST {{baseUrl}}/api/warehouses
Authorization: Bearer {{managerToken}}
Content-Type: text/plain

name=Giza Warehouse

### T06 Unknown route (expect 404 ROUTE_NOT_FOUND)
GET {{baseUrl}}/api/unknown
Authorization: Bearer {{managerToken}}

### ---------- ITEMS ----------

### T10 View all items (expect 200)
GET {{baseUrl}}/api/items
Authorization: Bearer {{managerToken}}

### T11 Search items (expect 200, only the box)
GET {{baseUrl}}/api/items?search=box
Authorization: Bearer {{managerToken}}

### T12 Create a valid item (expect 201 the first time, 409 DUPLICATE_SKU if it already exists)
# @name createItem
POST {{baseUrl}}/api/items
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Work Gloves",
  "sku": "GLV-PAIR-01",
  "category": "Safety"
}

### T13 Duplicate SKU (expect 409)
POST {{baseUrl}}/api/items
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Another Box",
  "sku": "box-lrg-01",
  "category": "Packaging"
}

### T14 Invalid SKU (expect 400)
POST {{baseUrl}}/api/items
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Bad SKU Item",
  "sku": "A B",
  "category": "Packaging"
}

### ---------- INVENTORY ----------

### T20 Stock of Cairo warehouse (expect 200)
GET {{baseUrl}}/api/warehouses/WH-101/inventory
Authorization: Bearer {{managerToken}}

### T21 Unknown warehouse (expect 404 WAREHOUSE_NOT_FOUND)
GET {{baseUrl}}/api/warehouses/WH-999/inventory
Authorization: Bearer {{managerToken}}

### T22 Add the new gloves from T12 to Cairo warehouse (expect 201; on a second run T12 creates nothing, so 404)
POST {{baseUrl}}/api/inventory
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "warehouseId": "WH-101",
  "itemId": "{{createItem.response.body.$.itemId}}",
  "quantity": 40
}

### T23 Same item again in same warehouse (expect 409 DUPLICATE_RECORD)
POST {{baseUrl}}/api/inventory
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "warehouseId": "WH-101",
  "itemId": "ITM-101",
  "quantity": 5
}

### T24 Negative quantity (expect 400 VALIDATION_ERROR)
POST {{baseUrl}}/api/inventory
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "warehouseId": "WH-101",
  "itemId": "ITM-102",
  "quantity": -3
}

### T25 Unknown item (expect 404 ITEM_NOT_FOUND)
POST {{baseUrl}}/api/inventory
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "warehouseId": "WH-101",
  "itemId": "ITM-999",
  "quantity": 5
}

### ---------- AVAILABILITY ----------

### T30 Enough stock (expect 200, isAvailable true)
GET {{baseUrl}}/api/inventory/availability?warehouseId=WH-101&itemId=ITM-101&quantity=30
Authorization: Bearer {{managerToken}}

### T31 Not enough stock (expect 200, isAvailable false)
GET {{baseUrl}}/api/inventory/availability?warehouseId=WH-101&itemId=ITM-101&quantity=80
Authorization: Bearer {{managerToken}}

### T32 Item not stocked in this warehouse (expect 200, available 0)
GET {{baseUrl}}/api/inventory/availability?warehouseId=WH-1795391950080&itemId=ITM-101&quantity=1
Authorization: Bearer {{managerToken}}

### T33 Missing quantity (expect 400 VALIDATION_ERROR)
GET {{baseUrl}}/api/inventory/availability?warehouseId=WH-101&itemId=ITM-101
Authorization: Bearer {{managerToken}}

### T34 Quantity 0 (expect 400 VALIDATION_ERROR)
GET {{baseUrl}}/api/inventory/availability?warehouseId=WH-101&itemId=ITM-101&quantity=0
Authorization: Bearer {{managerToken}}

### T35 Unknown warehouse (expect 404 WAREHOUSE_NOT_FOUND)
GET {{baseUrl}}/api/inventory/availability?warehouseId=WH-999&itemId=ITM-101&quantity=5
Authorization: Bearer {{managerToken}}

### T36 Unknown item (expect 404 ITEM_NOT_FOUND)
GET {{baseUrl}}/api/inventory/availability?warehouseId=WH-101&itemId=ITM-999&quantity=5
Authorization: Bearer {{managerToken}}

### ---------- STOCK UPDATES ----------

### T40 Receive 10 units (expect 200, quantity goes up by 10)
PATCH {{baseUrl}}/api/inventory/INV-101
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "change": 10
}

### T41 Dispatch 20 units (expect 200, quantity goes down by 20)
PATCH {{baseUrl}}/api/inventory/INV-101
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "change": -20
}

### T42 Remove more than in stock (expect 409 INSUFFICIENT_STOCK)
PATCH {{baseUrl}}/api/inventory/INV-101
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "change": -500
}

### T43 Change of 0 (expect 400 VALIDATION_ERROR)
PATCH {{baseUrl}}/api/inventory/INV-101
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "change": 0
}

### T44 Change as text (expect 400 VALIDATION_ERROR)
PATCH {{baseUrl}}/api/inventory/INV-101
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "change": "5"
}

### T45 Unknown record (expect 404 INVENTORY_NOT_FOUND)
PATCH {{baseUrl}}/api/inventory/INV-999
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "change": 5
}
### ---------- LOW STOCK ALERT (SNS) ----------

### T46 Dispatch tape down to 5 (expect 200, "lowStockAlert": true)
PATCH {{baseUrl}}/api/inventory/INV-1795395350736
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "change": -35
}

### T47 Put the tape back up to 40 (expect 200, "lowStockAlert": false)
PATCH {{baseUrl}}/api/inventory/INV-1795395350736
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "change": 35
}
### ---------- WHERE IS AN ITEM ----------

### T48 Where is the steel bracket stored (expect 200, list of warehouses and total)
GET {{baseUrl}}/api/items/ITM-101/stock
Authorization: Bearer {{managerToken}}

### T49 Unknown item (expect 404 ITEM_NOT_FOUND)
GET {{baseUrl}}/api/items/ITM-999/stock
Authorization: Bearer {{managerToken}}

### ---------- CHANGE AND DELETE (managers only) ----------
### A09 logged the staff account out, so U00 logs it in again for the staff tests below.

### U00 Log in as staff again (expect 200 with a token)
# @name loginStaffAgain
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "staff12",
  "password": "Staff12344"
}

### U01 Create a helmet to change and delete later (expect 201 the first time)
# @name helmet
POST {{baseUrl}}/api/items
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Safety Helmet",
  "sku": "HLM-01",
  "category": "Safety"
}

### U02 Manager changes its name and category (expect 200)
PATCH {{baseUrl}}/api/items/{{helmet.response.body.$.itemId}}
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Safety Helmet Yellow",
  "category": "Safety Gear"
}

### U03 Staff tries to change it (expect 403 FORBIDDEN)
PATCH {{baseUrl}}/api/items/{{helmet.response.body.$.itemId}}
Authorization: Bearer {{loginStaffAgain.response.body.$.token}}
Content-Type: application/json

{
  "name": "Helmet"
}

### U04 New SKU already belongs to another item (expect 409 DUPLICATE_SKU)
PATCH {{baseUrl}}/api/items/{{helmet.response.body.$.itemId}}
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "sku": "BOX-LRG-01"
}

### U05 Nothing to change (expect 400 VALIDATION_ERROR)
PATCH {{baseUrl}}/api/items/{{helmet.response.body.$.itemId}}
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{}

### U06 Change an item that does not exist (expect 404 ITEM_NOT_FOUND)
PATCH {{baseUrl}}/api/items/ITM-0000
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Ghost"
}

### U07 Put the helmet in Alexandria with 0 units (expect 201)
# @name helmetRecord
POST {{baseUrl}}/api/inventory
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "warehouseId": "WH-1795391950080",
  "itemId": "{{helmet.response.body.$.itemId}}",
  "quantity": 0
}

### U08 Delete the helmet while a warehouse still holds it (expect 409 ITEM_IN_USE)
DELETE {{baseUrl}}/api/items/{{helmet.response.body.$.itemId}}
Authorization: Bearer {{managerToken}}

### U09 Take a record that still has stock out of a warehouse (expect 409 NOT_EMPTY)
DELETE {{baseUrl}}/api/inventory/INV-101
Authorization: Bearer {{managerToken}}

### U10 Take the empty helmet record out of Alexandria (expect 204)
DELETE {{baseUrl}}/api/inventory/{{helmetRecord.response.body.$.inventoryId}}
Authorization: Bearer {{managerToken}}

### U11 Now delete the helmet (expect 204)
DELETE {{baseUrl}}/api/items/{{helmet.response.body.$.itemId}}
Authorization: Bearer {{managerToken}}

### U12 Delete it again (expect 404 ITEM_NOT_FOUND)
DELETE {{baseUrl}}/api/items/{{helmet.response.body.$.itemId}}
Authorization: Bearer {{managerToken}}

### U13 Staff tries to delete an item (expect 403 FORBIDDEN)
DELETE {{baseUrl}}/api/items/ITM-101
Authorization: Bearer {{loginStaffAgain.response.body.$.token}}

### W01 Manager saves Alexandria's name and city (expect 200)
PATCH {{baseUrl}}/api/warehouses/WH-1795391950080
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Alexandria Warehouse",
  "location": "Alexandria"
}

### W02 Rename it to a name another warehouse has (expect 409 DUPLICATE_WAREHOUSE)
PATCH {{baseUrl}}/api/warehouses/WH-1795391950080
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Cairo Main Warehouse"
}

### W03 Name too short (expect 400 VALIDATION_ERROR)
PATCH {{baseUrl}}/api/warehouses/WH-1795391950080
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "A"
}

### W04 Warehouse that does not exist (expect 404 WAREHOUSE_NOT_FOUND)
PATCH {{baseUrl}}/api/warehouses/WH-0000
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "location": "Giza"
}

### W05 Staff tries to rename a warehouse (expect 403 FORBIDDEN)
PATCH {{baseUrl}}/api/warehouses/WH-101
Authorization: Bearer {{loginStaffAgain.response.body.$.token}}
Content-Type: application/json

{
  "name": "My Warehouse"
}

### ---------- LOW-STOCK ALERTS (SNS -> SQS) ----------

### AL01 Take Cairo's tape down to 5, below the limit of 10 (expect 200, lowStockAlert true)
PATCH {{baseUrl}}/api/inventory/INV-1795395350736
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "change": -35
}

### AL02 Manager reads the new alerts from the queue (expect 200, the tape alert is in the list)
GET {{baseUrl}}/api/alerts
Authorization: Bearer {{managerToken}}

### AL03 Read again: each alert is delivered once (expect 200, empty list)
GET {{baseUrl}}/api/alerts
Authorization: Bearer {{managerToken}}

### AL04 Staff tries to read the alerts (expect 403 FORBIDDEN)
GET {{baseUrl}}/api/alerts
Authorization: Bearer {{loginStaffAgain.response.body.$.token}}

### AL05 Put Cairo's tape back to 40 (expect 200)
PATCH {{baseUrl}}/api/inventory/INV-1795395350736
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "change": 35
}
