{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MovementTableOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/StockMovements"
    },
    {
      "Sid": "ReadAndUpdateTransfersOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/TransferRequests"
    },
    {
      "Sid": "TrackingFrontendBucketOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::tracking-frontend",
        "arn:aws:s3:::tracking-frontend/*"
      ]
    },
    {
      "Sid": "TrackingTopicOnly",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:us-east-1:000000000000:transfer-tracking-topic"
    },
    {
      "Sid": "TrackingQueueReadOnly",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage"
      ],
      "Resource": "arn:aws:sqs:us-east-1:000000000000:transfer-tracking-events"
    },
    {
      "Sid": "LambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    }
  ]
}
