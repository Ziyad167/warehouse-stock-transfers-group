{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TransferTableOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/TransferRequests"
    },
    {
      "Sid": "TransfersFrontendBucketOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::transfers-frontend",
        "arn:aws:s3:::transfers-frontend/*"
      ]
    }
  ]
}
